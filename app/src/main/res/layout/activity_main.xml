<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@color/gris">

        <TextView
            android:id="@+id/titol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:text="@string/titolMain"
            android:textSize="22sp"
            android:textAlignment="center"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginTop="30dp"
            />

        <androidx.cardview.widget.CardView
            android:id="@+id/home"
            android:layout_width="0dp"
            android:layout_height="150dp"
            app:cardBackgroundColor="@color/fonsCards"
            app:cardCornerRadius="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/titol"
            app:layout_constraintEnd_toStartOf="@+id/dona"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginLeft="16dp"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                >
                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/baseline_male_24"
                    android:contentDescription="@string/cdHome">
                </ImageView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/male"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/lletra">

                </TextView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/dona"
            android:layout_width="0dp"
            android:layout_height="150dp"
            app:cardBackgroundColor="@color/fonsCards"
            app:cardCornerRadius="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/titol"
            app:layout_constraintStart_toEndOf="@+id/home"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginLeft="16dp"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/baseline_female_24"
                    android:contentDescription="@string/cdDona">
                </ImageView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/female"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/lletra">
                </TextView>
            </LinearLayout>



        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/pes"
            android:layout_width="0dp"
            android:layout_height="150dp"
            app:layout_constraintTop_toBottomOf="@id/home"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:cardBackgroundColor="@color/fonsPes"
            app:cardCornerRadius="16dp"
            android:layout_marginTop="30dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/height"
                    android:textColor="@color/lletra"
                    android:textSize="16sp"
                    android:layout_marginTop="8dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvAltura"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="73"
                        android:textColor="@color/white"
                        android:textSize="35sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/inches"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/rsAltura"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:layout_marginStart="16dp"
                    android:progressTint="@color/barraPes"
                    android:thumbTint="@color/barraPes"
                    android:max="200"
                    android:progress="73"
                    android:thumb="@drawable/bolita_personalitzada"
                    android:layout_marginTop="10dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
                android:id="@+id/altura"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="170dp"
                app:layout_constraintTop_toBottomOf="@id/pes"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/edat"
                app:cardBackgroundColor="@color/fonsCards"
                android:layout_marginTop="30dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="24dp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/weight"
                        android:textSize="18sp"
                        android:layout_marginTop="8dp"
                        >
                    </TextView>
                    <TextView
                        android:id="@+id/tvPes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="170"
                        android:textColor="@color/white"
                        android:textSize="40sp"
                        android:fontFamily="sans-serif-black"
                        >
                    </TextView>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        tools:ignore="ButtonStyle">
                        <Button
                            android:id="@+id/menysAltura"
                            android:contentDescription="@string/cdMenysAltura"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="56dp"
                            android:minHeight="56dp"
                            android:text="@string/restar"
                            android:textColor="@color/black"
                            android:backgroundTint="@color/fonsBoto"
                            android:textSize="32sp"
                            android:fontFamily="sans-serif-black"
                            app:cornerRadius="28dp"
                            android:padding="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:layout_marginStart="8dp">
                        </Button>
                        <Button
                            android:id="@+id/mesAltura"
                            android:contentDescription="@string/cdMesAltura"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="56dp"
                            android:minHeight="56dp"
                            android:text="@string/sumar"
                            android:textColor="@color/black"
                            android:backgroundTint="@color/fonsBoto"
                            android:textSize="32sp"
                            android:fontFamily="sans-serif-black"
                            app:cornerRadius="28dp"
                            android:padding="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:layout_marginStart="8dp">
                        </Button>
                    </LinearLayout>
                </LinearLayout>


            </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/edat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="170dp"
            app:layout_constraintTop_toBottomOf="@id/pes"
            app:layout_constraintStart_toEndOf="@id/altura"
            app:layout_constraintEnd_toEndOf="parent"
            app:cardBackgroundColor="@color/fonsCards"
            android:layout_marginTop="30dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="24dp"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/age"
                    android:textSize="18sp"
                    android:layout_marginTop="8dp"
                    >
                </TextView>
                <TextView
                    android:id="@+id/tvEdat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="18"
                    android:textColor="@color/white"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"
                    >
                </TextView>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    tools:ignore="ButtonStyle">
                    <Button
                        android:id="@+id/menysEdat"
                        android:contentDescription="@string/cdMenysEdat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="56dp"
                        android:minHeight="56dp"
                        android:text="@string/restar"
                        android:textColor="@color/black"
                        android:backgroundTint="@color/fonsBoto"
                        android:textSize="32sp"
                        android:fontFamily="sans-serif-black"
                        app:cornerRadius="28dp"
                        android:padding="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:layout_marginStart="8dp">
                    </Button>
                    <Button
                        android:id="@+id/mesEdat"
                        android:contentDescription="@string/cdMesEdat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="56dp"
                        android:minHeight="56dp"
                        android:text="@string/sumar"
                        android:textColor="@color/black"
                        android:backgroundTint="@color/fonsBoto"
                        android:textSize="32sp"
                        android:fontFamily="sans-serif-black"
                        app:cornerRadius="28dp"
                        android:padding="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:layout_marginStart="8dp">
                    </Button>
                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnCalculate"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:text="@string/calculate"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/white"
        app:cornerRadius="0dp"
        android:backgroundTint="@color/colorCalculate"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="30dp"
        android:gravity="center_horizontal"
        />

</androidx.constraintlayout.widget.ConstraintLayout>