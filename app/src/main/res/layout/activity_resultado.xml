<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/gris"
    android:id="@+id/resultatmain">

    <Button
        android:id="@+id/botoRes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="<"
        android:textSize="32sp"
        android:backgroundTint="@color/gris"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="16dp"
        >
    </Button>
    <TextView
        android:id="@+id/titolRes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="BMI Results"
        android:textSize="22sp"
        android:textAlignment="center"
        android:textColor="@color/white"
        app:layout_constraintStart_toEndOf="@id/botoRes"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/botoRes"
        android:layout_marginTop="16dp"
        >
    </TextView>
    <TextView
        android:id="@+id/textRes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your Results"
        android:textSize="50sp"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/botoRes"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp"
        >
    </TextView>
    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/textRes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        >


    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>